diff --git a/include/sketch_vec_store.h b/include/sketch_vec_store.h
new file mode 100644
index 0000000..8594bfc
--- /dev/null
+++ b/include/sketch_vec_store.h
@@ -0,0 +1,94 @@
+#pragma once
+// Resident SQ8 records of the SA L0 sketch nodes (replaces unordered_map<node_id_t, vector<uint8_t>>).
+// Records live in fixed-size chunks (no whole-arena reallocation, no per-record heap block); ids map to
+// slots through a dense int32 table (ids < 2^31) with an unordered_map fallback for larger ids.
+// Per record: rec_size payload + 4 B index (+ the dense table's span) instead of ~70 B of map/heap overhead.
+#include <cstdint>
+#include <cstring>
+#include <memory>
+#include <unordered_map>
+#include <vector>
+
+#include "disk_vector.h"
+
+namespace lsm_vec {
+
+class SketchVecStore {
+public:
+    void setRecordSize(size_t rec) { if (rec_ != rec) { clear(); rec_ = rec; } }
+    size_t recordSize() const { return rec_; }
+    size_t size() const { return live_; }
+    bool count(node_id_t id) const { return slotOf(id) >= 0; }
+
+    const uint8_t* find(node_id_t id) const {
+        const int64_t s = slotOf(id);
+        return s < 0 ? nullptr : ptr(static_cast<uint32_t>(s));
+    }
+    uint8_t* findMutable(node_id_t id) {
+        const int64_t s = slotOf(id);
+        return s < 0 ? nullptr : ptr(static_cast<uint32_t>(s));
+    }
+    // Inserts a copy of `rec` (rec_ bytes) if `id` is absent; returns false if it was present.
+    bool insert(node_id_t id, const uint8_t* rec) {
+        if (count(id)) return false;
+        uint32_t s;
+        if (!free_.empty()) { s = free_.back(); free_.pop_back(); }
+        else {
+            s = next_++;
+            if ((s >> kShift) >= chunks_.size())
+                chunks_.emplace_back(new uint8_t[static_cast<size_t>(kChunk) * rec_]);
+        }
+        std::memcpy(ptr(s), rec, rec_);
+        setSlot(id, static_cast<int32_t>(s));
+        ++live_;
+        return true;
+    }
+    void erase(node_id_t id) {
+        const int64_t s = slotOf(id);
+        if (s < 0) return;
+        free_.push_back(static_cast<uint32_t>(s));
+        setSlot(id, -1);
+        --live_;
+    }
+    void clear() {
+        chunks_.clear(); dense_.clear(); dense_.shrink_to_fit(); sparse_.clear();
+        free_.clear(); free_.shrink_to_fit(); next_ = 0; live_ = 0;
+    }
+    template <class Fn> void forEach(Fn&& fn) const {  // fn(id, const uint8_t* rec)
+        for (size_t id = 0; id < dense_.size(); ++id)
+            if (dense_[id] >= 0) fn(static_cast<node_id_t>(id), ptr(static_cast<uint32_t>(dense_[id])));
+        for (const auto& kv : sparse_) fn(kv.first, ptr(kv.second));
+    }
+    size_t bytes() const {
+        return chunks_.size() * static_cast<size_t>(kChunk) * rec_ + dense_.capacity() * sizeof(int32_t) +
+               free_.capacity() * sizeof(uint32_t) + sparse_.size() * 48;
+    }
+
+private:
+    static constexpr uint32_t kShift = 16, kChunk = 1u << kShift;  // 65,536 records per chunk
+    static constexpr node_id_t kDenseLimit = node_id_t{1} << 31;
+    uint8_t* ptr(uint32_t s) const { return chunks_[s >> kShift].get() + static_cast<size_t>(s & (kChunk - 1)) * rec_; }
+    int64_t slotOf(node_id_t id) const {
+        if (id < kDenseLimit) return static_cast<size_t>(id) < dense_.size() ? dense_[static_cast<size_t>(id)] : -1;
+        auto it = sparse_.find(id);
+        return it == sparse_.end() ? -1 : it->second;
+    }
+    void setSlot(node_id_t id, int32_t s) {
+        if (id < kDenseLimit) {
+            const size_t i = static_cast<size_t>(id);
+            if (i >= dense_.size()) dense_.resize(std::max(i + 1, dense_.size() + dense_.size() / 2), -1);
+            dense_[i] = s;
+        } else if (s < 0) sparse_.erase(id);
+        else sparse_[id] = static_cast<uint32_t>(s);
+    }
+
+    size_t rec_ = 0;
+    std::vector<std::unique_ptr<uint8_t[]>> chunks_;
+    std::vector<int32_t> dense_;
+    std::unordered_map<node_id_t, uint32_t> sparse_;
+    std::vector<uint32_t> free_;
+    uint32_t next_ = 0;
+    size_t live_ = 0;
+};
+
+}  // namespace lsm_vec
