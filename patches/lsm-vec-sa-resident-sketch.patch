+// Sharded / out-of-core RNN-Descent (see include/lsm_vec_sharded_build.h and
+// bench docs/PLAN_sharded_build_impl.md).
+//
+//   B1 sample + k-means      (centroids = shard seeds)
+//   B2 assignment            (each point -> its `overlap` nearest centroids)
+//   B3 per-shard RNND        (one shard resident at a time; spill lists to disk)
+//   B4 k-way merge           (union, dedup, top-R by distance -> global CSR)
+
+#include "lsm_vec_sharded_build.h"
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <filesystem>
+#include <fstream>
+#include <limits>
+#include <stdexcept>
+#include <thread>
+
+#include "distance.h"
+#include "logger.h"
+
+namespace lsm_vec::sharded {
+
+namespace {
+
+namespace fs = std::filesystem;
+
+template <typename Body>
+void parallel_for(size_t begin, size_t end, size_t chunk_size, int num_threads,
+                  Body body) {
+    if (num_threads <= 1 || end - begin <= chunk_size) {
+        for (size_t i = begin; i < end; ++i) body(i);
+        return;
+    }
+    std::atomic<size_t> cursor{begin};
+    std::vector<std::thread> threads;
+    threads.reserve(static_cast<size_t>(num_threads));
+    for (int t = 0; t < num_threads; ++t) {
+        threads.emplace_back([&]() {
+            while (true) {
+                size_t start = cursor.fetch_add(chunk_size,
+                                                std::memory_order_relaxed);
+                if (start >= end) break;
+                size_t stop = std::min(start + chunk_size, end);
+                for (size_t i = start; i < stop; ++i) body(i);
+            }
+        });
+    }
+    for (auto& th : threads) th.join();
+}
+
+uint64_t mix64(uint64_t x) {
+    x = (x ^ (x >> 30)) * 0xbf58476d1ce4e5b9ULL;
+    x = (x ^ (x >> 27)) * 0x94d049bb133111ebULL;
+    return x ^ (x >> 31);
+}
+
+// Squared L2 — sharding is a spatial partition, so plain L2 geometry is
+// used for centroids under every metric (for cosine this is a heuristic
+// partition; per-shard RNND and the merge still use the true metric).
+float l2sq(const float* a, const float* b, int dim) {
+    return lsm_vec::distance::L2SquaredDistance(a, b, dim);
+}
+
+struct KmeansResult {
+    std::vector<float> centroids;  // k x dim
+    int k = 0;
+};
+
+// B1: deterministic sample + Lloyd's k-means.
+KmeansResult sampleKmeans(const float* vectors, size_t n, int dim, int k,
+                          int sample_size, int iters, int num_threads,
+                          uint32_t seed) {
+    const size_t sample_n = std::min<size_t>(sample_size, n);
+    // Stride sample with a hashed jitter — deterministic, near-uniform.
+    std::vector<float> sample(sample_n * static_cast<size_t>(dim));
+    const double step = static_cast<double>(n) / static_cast<double>(sample_n);
+    std::vector<size_t> sample_ids(sample_n);
+    for (size_t i = 0; i < sample_n; ++i) {
+        size_t lo = static_cast<size_t>(i * step);
+        size_t span = std::max<size_t>(1, static_cast<size_t>(step));
+        sample_ids[i] = std::min(n - 1, lo + mix64(seed ^ (0xa5a5ULL + i)) % span);
+    }
+    parallel_for(0, sample_n, 4096, num_threads, [&](size_t i) {
+        std::memcpy(&sample[i * dim], vectors + sample_ids[i] * dim,
+                    sizeof(float) * static_cast<size_t>(dim));
+    });
+
+    KmeansResult res;
+    res.k = k;
+    res.centroids.resize(static_cast<size_t>(k) * dim);
+    // Init: k spread picks from the sample (deterministic).
+    for (int c = 0; c < k; ++c) {
+        size_t pick = (sample_n * static_cast<size_t>(c)) / k;
+        pick = std::min(sample_n - 1,
+                        pick + mix64(seed ^ (0xc0ffee + c)) % std::max<size_t>(1, sample_n / (2 * k)));
+        std::memcpy(&res.centroids[static_cast<size_t>(c) * dim],
+                    &sample[pick * dim], sizeof(float) * dim);
+    }
+
+    std::vector<int> assign(sample_n, 0);
+    for (int it = 0; it < iters; ++it) {
+        parallel_for(0, sample_n, 2048, num_threads, [&](size_t i) {
+            const float* v = &sample[i * dim];
+            float best = std::numeric_limits<float>::max();
+            int bc = 0;
+            for (int c = 0; c < k; ++c) {
+                float d = l2sq(v, &res.centroids[static_cast<size_t>(c) * dim], dim);
+                if (d < best) { best = d; bc = c; }
+            }
+            assign[i] = bc;
+        });
+        std::vector<double> sums(static_cast<size_t>(k) * dim, 0.0);
+        std::vector<size_t> counts(static_cast<size_t>(k), 0);
+        for (size_t i = 0; i < sample_n; ++i) {
+            const float* v = &sample[i * dim];
+            double* s = &sums[static_cast<size_t>(assign[i]) * dim];
+            for (int d = 0; d < dim; ++d) s[d] += v[d];
+            counts[assign[i]]++;
+        }
+        for (int c = 0; c < k; ++c) {
+            if (counts[c] == 0) {
+                // Empty cluster: reseed from a hashed sample point.
+                size_t pick = mix64(seed ^ (0xdead + c * 31 + it)) % sample_n;
+                std::memcpy(&res.centroids[static_cast<size_t>(c) * dim],
+                            &sample[pick * dim], sizeof(float) * dim);
+                continue;
+            }
+            float* cv = &res.centroids[static_cast<size_t>(c) * dim];
+            const double* s = &sums[static_cast<size_t>(c) * dim];
+            for (int d = 0; d < dim; ++d)
+                cv[d] = static_cast<float>(s[d] / counts[c]);
+        }
+    }
+    return res;
+}
+
+// Split one oversized member list in two via 2-means over its points
+// (members stay sorted; each member goes to exactly one half).
+void splitShard(const float* vectors, int dim, int num_threads, uint32_t seed,
+                std::vector<uint32_t>& members, std::vector<uint32_t>& spill) {
+    const size_t m = members.size();
+    float c0[1024], c1[1024];  // dim <= 1024 for all our datasets
+    if (dim > 1024) throw std::runtime_error("splitShard: dim > 1024 unsupported");
+    size_t p0 = members[mix64(seed ^ 0x51ee) % m];
+    size_t p1 = members[mix64(seed ^ 0x7a3b) % m];
+    std::memcpy(c0, vectors + p0 * dim, sizeof(float) * dim);
+    std::memcpy(c1, vectors + p1 * dim, sizeof(float) * dim);
+    std::vector<uint8_t> side(m, 0);
+    for (int it = 0; it < 5; ++it) {
+        parallel_for(0, m, 4096, num_threads, [&](size_t i) {
+            const float* v = vectors + static_cast<size_t>(members[i]) * dim;
+            side[i] = l2sq(v, c1, dim) < l2sq(v, c0, dim) ? 1 : 0;
+        });
+        std::vector<double> s0(dim, 0.0), s1(dim, 0.0);
+        size_t n0 = 0, n1 = 0;
+        for (size_t i = 0; i < m; ++i) {
+            const float* v = vectors + static_cast<size_t>(members[i]) * dim;
+            if (side[i]) { for (int d = 0; d < dim; ++d) s1[d] += v[d]; n1++; }
+            else         { for (int d = 0; d < dim; ++d) s0[d] += v[d]; n0++; }
+        }
+        if (n0 == 0 || n1 == 0) break;  // degenerate: keep previous centroids
+        for (int d = 0; d < dim; ++d) {
+            c0[d] = static_cast<float>(s0[d] / n0);
+            c1[d] = static_cast<float>(s1[d] / n1);
+        }
+    }
+    std::vector<uint32_t> keep;
+    keep.reserve(m / 2 + 1);
+    spill.clear();
+    spill.reserve(m / 2 + 1);
+    for (size_t i = 0; i < m; ++i) {
+        (side[i] ? spill : keep).push_back(members[i]);
+    }
+    if (keep.empty() || spill.empty()) {
+        // 2-means failed to separate (duplicate points); halve arbitrarily.
+        keep.assign(members.begin(), members.begin() + static_cast<ptrdiff_t>(m / 2));
+        spill.assign(members.begin() + static_cast<ptrdiff_t>(m / 2), members.end());
+    }
+    members.swap(keep);  // both halves remain sorted (stable partition of a sorted list)
+}
+
+struct ShardFileReader {
+    std::ifstream in;
+    uint32_t gid = 0;
+    std::vector<std::pair<int, float>> list;  // (neighbor, dist)
+    bool ok = false;
+
+    explicit ShardFileReader(const std::string& path) : in(path, std::ios::binary) {
+        if (!in) throw std::runtime_error("sharded merge: cannot open " + path);
+        next();
+    }
+    void next() {
+        uint16_t deg;
+        if (!in.read(reinterpret_cast<char*>(&gid), 4)) { ok = false; return; }
+        if (!in.read(reinterpret_cast<char*>(&deg), 2)) { ok = false; return; }
+        list.resize(deg);
+        for (uint16_t i = 0; i < deg; ++i) {
+            uint32_t nbr; float d;
+            in.read(reinterpret_cast<char*>(&nbr), 4);
+            in.read(reinterpret_cast<char*>(&d), 4);
+            list[i] = {static_cast<int>(nbr), d};
+        }
+        if (!in) throw std::runtime_error("sharded merge: truncated shard file");
+        ok = true;
+    }
+};
+
+}  // namespace
+
+ShardedCsr BuildShardedKnnGraph(const float* vectors, size_t n, int dim,
+                                DistanceMetric metric,
+                                const ShardedBuildParams& p) {
+    using clock = std::chrono::steady_clock;
+    if (p.shard_count <= 1)
+        throw std::runtime_error("BuildShardedKnnGraph: shard_count must be > 1");
+    if (n > static_cast<size_t>(std::numeric_limits<int>::max()))
+        throw std::runtime_error("BuildShardedKnnGraph: n exceeds int32 id space");
+    if (p.tmp_dir.empty())
+        throw std::runtime_error("BuildShardedKnnGraph: tmp_dir not set");
+
+    const int k = std::min<int>(p.shard_count, std::max<int>(2, static_cast<int>(n / 2)));
+    const int overlap = std::max(1, std::min(p.overlap, k));
+    if (overlap > 8)
+        throw std::runtime_error("BuildShardedKnnGraph: overlap > 8 unsupported");
+    const int nthreads = std::max(1, p.num_threads);
+
+    LOG(INFO) << "[sharded] n=" << n << " dim=" << dim << " shards=" << k
+              << " overlap=" << overlap << " threads=" << nthreads << " START";
+    auto t0 = clock::now();
+
+    // ----- B1: sample + k-means -----
+    KmeansResult km = sampleKmeans(vectors, n, dim, k, p.sample_size,
+                                   p.kmeans_iters, nthreads, p.seed);
+
+    // ----- B2: assignment to `overlap` nearest centroids -----
+    std::vector<std::vector<uint32_t>> members(static_cast<size_t>(k));
+    {
+        // Per-thread buckets, concatenated after — no locks on the hot path.
+        const int T = nthreads;
+        std::vector<std::vector<std::vector<uint32_t>>> tl(
+            static_cast<size_t>(T),
+            std::vector<std::vector<uint32_t>>(static_cast<size_t>(k)));
+        std::atomic<int> tcounter{0};
+        thread_local int tid_tl = -1;
+        // parallel_for spawns fresh threads; hand out thread ids via atomic.
+        parallel_for(0, n, 8192, nthreads, [&](size_t i) {
+            if (tid_tl < 0) tid_tl = tcounter.fetch_add(1) % T;
+            const float* v = vectors + i * static_cast<size_t>(dim);
+            // top-`overlap` centroids by partial selection over k distances
+            float bd[8];
+            int bc[8];
+            for (int o = 0; o < overlap; ++o) { bd[o] = std::numeric_limits<float>::max(); bc[o] = -1; }
+            for (int c = 0; c < k; ++c) {
+                float d = l2sq(v, &km.centroids[static_cast<size_t>(c) * dim], dim);
+                for (int o = 0; o < overlap; ++o) {
+                    if (d < bd[o]) {
+                        for (int q = overlap - 1; q > o; --q) { bd[q] = bd[q-1]; bc[q] = bc[q-1]; }
+                        bd[o] = d; bc[o] = c;
+                        break;
+                    }
+                }
+            }
+            for (int o = 0; o < overlap; ++o)
+                if (bc[o] >= 0) tl[tid_tl][bc[o]].push_back(static_cast<uint32_t>(i));
+        });
+        for (int c = 0; c < k; ++c) {
+            size_t tot = 0;
+            for (int t = 0; t < T; ++t) tot += tl[t][c].size();
+            members[c].reserve(tot);
+            for (int t = 0; t < T; ++t) {
+                members[c].insert(members[c].end(), tl[t][c].begin(), tl[t][c].end());
+                std::vector<uint32_t>().swap(tl[t][c]);
+            }
+            std::sort(members[c].begin(), members[c].end());
+        }
+    }
+
+    // Skew guard: split any shard over 1.3x the expected size.
+    {
+        const size_t cap = static_cast<size_t>(
+            1.3 * (static_cast<double>(n) * overlap / k)) + 1;
+        for (size_t s = 0; s < members.size(); ++s) {
+            while (members[s].size() > cap) {
+                std::vector<uint32_t> spill;
+                splitShard(vectors, dim, nthreads,
+                           p.seed ^ static_cast<uint32_t>(0x5eed0000 + members.size()),
+                           members[s], spill);
+                LOG(INFO) << "[sharded] split oversized shard " << s << " -> "
+                          << members[s].size() << " + " << spill.size();
+                members.push_back(std::move(spill));
+            }
+        }
+    }
+    {
+        size_t mn = SIZE_MAX, mx = 0, tot = 0;
+        for (auto& m : members) { mn = std::min(mn, m.size()); mx = std::max(mx, m.size()); tot += m.size(); }
+        LOG(INFO) << "[sharded] B2 assignment done: shards=" << members.size()
+                  << " min=" << mn << " max=" << mx << " total_assignments=" << tot;
+    }
+
+    // ----- B3: per-shard RNND, spill to disk -----
+    fs::create_directories(p.tmp_dir);
+    std::vector<std::string> shard_files;
+    for (size_t s = 0; s < members.size(); ++s) {
+        const auto& mem = members[s];
+        if (mem.empty()) continue;
+        auto ts = clock::now();
+        const size_t sn = mem.size();
+        if (sn * static_cast<size_t>(p.rnnd_R) >
+            static_cast<size_t>(std::numeric_limits<int>::max()))
+            throw std::runtime_error(
+                "sharded: shard too large for the per-shard int32 CSR "
+                "(raise shard_count)");
+        std::vector<float> blob(sn * static_cast<size_t>(dim));
+        parallel_for(0, sn, 2048, nthreads, [&](size_t i) {
+            std::memcpy(&blob[i * dim],
+                        vectors + static_cast<size_t>(mem[i]) * dim,
+                        sizeof(float) * static_cast<size_t>(dim));
+        });
+
+        rnn_descent::FlatStorageDistance fdist(blob.data(), static_cast<int>(sn),
+                                               dim, metric);
+        rnn_descent::RNNDescentBuilder rnnd(dim);
+        rnnd.S = p.rnnd_S;
+        rnnd.T1 = p.rnnd_T1;
+        rnnd.T2 = p.rnnd_T2;
+        rnnd.R = p.rnnd_R;
+        rnnd.num_threads = nthreads;
+        rnnd.random_seed = p.seed ^ (0x9e3779b9u * static_cast<uint32_t>(s + 1));
+        rnnd.keep_distances = true;
+        rnnd.build(fdist, static_cast<int>(sn));
+        std::vector<float>().swap(blob);
+
+        std::string path = p.tmp_dir + "/shard_" + std::to_string(s) + ".bin";
+        std::ofstream out(path, std::ios::binary);
+        if (!out) throw std::runtime_error("sharded: cannot write " + path);
+        std::vector<char> iobuf(1 << 20);
+        out.rdbuf()->pubsetbuf(iobuf.data(), static_cast<std::streamsize>(iobuf.size()));
+        // Members are sorted ascending, so records come out sorted by global id.
+        for (size_t u = 0; u < sn; ++u) {
+            uint32_t gid = mem[u];
+            int b = rnnd.offsets[u], e = rnnd.offsets[u + 1];
+            uint16_t deg = static_cast<uint16_t>(e - b);
+            out.write(reinterpret_cast<const char*>(&gid), 4);
+            out.write(reinterpret_cast<const char*>(&deg), 2);
+            for (int i = b; i < e; ++i) {
+                uint32_t nbr = mem[rnnd.final_graph[i]];  // local -> global
+                out.write(reinterpret_cast<const char*>(&nbr), 4);
+                out.write(reinterpret_cast<const char*>(&rnnd.final_dists[i]), 4);
+            }
+        }
+        out.close();
+        if (!out) throw std::runtime_error("sharded: short write " + path);
+        shard_files.push_back(path);
+        LOG(INFO) << "[sharded] B3 shard " << s << "/" << members.size()
+                  << " n=" << sn << " built+spilled in "
+                  << std::chrono::duration<double>(clock::now() - ts).count() << "s";
+    }
+    for (auto& m : members) std::vector<uint32_t>().swap(m);
+
+    // ----- B4: k-way merge -> global CSR -----
+    ShardedCsr csr;
+    csr.offsets.reserve(n + 1);
+    csr.offsets.push_back(0);
+    csr.neighbors.reserve(n * static_cast<size_t>(p.rnnd_R));  // most nodes hit deg=R; avoids growth-doubling peaks
+    {
+        std::vector<ShardFileReader> readers;
+        readers.reserve(shard_files.size());
+        for (auto& f : shard_files) readers.emplace_back(f);
+        std::vector<std::pair<int, float>> cand;
+        std::vector<int> accepted;
+        for (size_t expect = 0; expect < n; ++expect) {
+            cand.clear();
+            bool found = false;
+            for (auto& r : readers) {
+                if (r.ok && r.gid == expect) {
+                    cand.insert(cand.end(), r.list.begin(), r.list.end());
+                    r.next();
+                    found = true;
+                }
+            }
+            if (!found)
+                throw std::runtime_error(
+                    "sharded merge: id " + std::to_string(expect) +
+                    " missing from every shard (coverage violation)");
+            std::sort(cand.begin(), cand.end(),
+                      [](const auto& a, const auto& b) { return a.second < b.second; });
+            accepted.clear();
+            for (auto& [id, d] : cand) {
+                (void)d;
+                if (id == static_cast<int>(expect)) continue;
+                bool dup = false;
+                for (int a : accepted)
+                    if (a == id) { dup = true; break; }
+                if (dup) continue;
+                accepted.push_back(id);
+                if (static_cast<int>(accepted.size()) >= p.rnnd_R) break;
+            }
+            csr.neighbors.insert(csr.neighbors.end(), accepted.begin(), accepted.end());
+            csr.offsets.push_back(static_cast<int64_t>(csr.neighbors.size()));
+        }
+        for (auto& r : readers) {
+            if (r.ok)
+                throw std::runtime_error("sharded merge: trailing records past n");
+        }
+    }
+    std::error_code ec;
+    for (auto& f : shard_files) fs::remove(f, ec);
+    fs::remove(p.tmp_dir, ec);  // succeeds only if now empty — fine either way
+
+    LOG(INFO) << "[sharded] DONE n=" << n << " edges=" << csr.neighbors.size()
+              << " wall=" << std::chrono::duration<double>(clock::now() - t0).count()
+              << "s";
+    return csr;
+}
+
+}  // namespace lsm_vec::sharded
