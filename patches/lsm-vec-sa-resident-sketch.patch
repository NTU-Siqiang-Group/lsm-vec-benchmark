+SaTree SaSketch::toTree() const
+{
+    SaTree t;
+    t.nodes.resize(nodes.size());
+    for (size_t i = 0; i < nodes.size(); ++i) {
+        const SaSketchNode& n = nodes[i];
+        SaTreeNode& o = t.nodes[i];
+        o.id = n.id; o.radius = n.radius; o.parent_dist = n.parent_dist;
+        o.children.reserve(n.n_children);
+        for (uint32_t c = n.first_child; c != kSaNoIndex; c = nodes[c].next_sibling) o.children.push_back(c);
+    }
+    t.root_index = empty() ? std::numeric_limits<uint32_t>::max() : root_index;
+    return t;
+}
+
+uint32_t saTreeMaxRootToLeafDepthEdges(const SaSketch& tree)
+{
+    if (tree.empty() || tree.root_index >= tree.nodes.size()) return 0;
+    uint32_t best = 0;
+    std::vector<std::pair<uint32_t, uint32_t>> stack{{tree.root_index, 0}};
+    while (!stack.empty()) {
+        const auto pr = stack.back();
+        stack.pop_back();
+        const SaSketchNode& n = tree.nodes[pr.first];
+        if (n.first_child == kSaNoIndex) { best = std::max(best, pr.second); continue; }
+        for (uint32_t c = n.first_child; c != kSaNoIndex; c = tree.nodes[c].next_sibling)
+            stack.push_back({c, pr.second + 1});
+    }
+    return best;
+}
