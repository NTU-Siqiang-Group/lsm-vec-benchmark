diff --git a/include/coupled_node_store.h b/include/coupled_node_store.h
new file mode 100644
index 0000000..90170c2
--- /dev/null
+++ b/include/coupled_node_store.h
@@ -0,0 +1,193 @@
+#pragma once
+// E4 coupled-layout ablation (PVLDB revision). In the coupled layout each layer-0 node is ONE record
+// in the LSM-tree: [u32 n_out][int64 out_ids...][SQ8 vector (dim + 8 bytes)]. Everything else in
+// LSM-Vec is unchanged. Consequences this layout makes measurable:
+//   * an edge-only change is a read-modify-write of the whole record, vector included;
+//   * reading a candidate's vector also fetches its adjacency list, which is wasted unless the
+//     candidate is later expanded (tracked per query: begin/endQuery).
+// The out-list encoding (sorted int64 ids) matches Aster's, so with Aster's out-edges-only mode the
+// decoupled arm stores identical edge bytes and coupling is the only difference.
+#include <algorithm>
+#include <cstdint>
+#include <cstring>
+#include <functional>
+#include <string>
+#include <unordered_map>
+#include <unordered_set>
+#include <vector>
+
+#include "disk_vector.h"
+#include "rocksdb/db.h"
+
+namespace lsm_vec {
+
+class CoupledNodeStore {
+public:
+    struct Stats {
+        uint64_t gets = 0, get_bytes = 0;          // record reads (any path)
+        uint64_t vec_gets = 0, vec_get_bytes = 0;  // record reads issued for a vector
+        uint64_t edge_gets = 0, edge_get_bytes = 0;// record reads issued for an adjacency list
+        uint64_t puts = 0, put_bytes = 0;          // record writes (logical value bytes)
+        uint64_t put_vec_bytes = 0;                // vector bytes carried by those writes
+        uint64_t unused_edge_bytes = 0;            // adjacency bytes fetched with a vector, never expanded
+        uint64_t queries = 0;
+    };
+
+    CoupledNodeStore(ROCKSDB_NAMESPACE::DB* db, size_t dim) : db_(db), dim_(dim),
+        vec_bytes_(PagedVectorStorage::sq8RecordSize(dim)) {}
+
+    size_t dim() const { return dim_; }
+    const Stats& stats() const { return st_; }
+    void resetStats() { st_ = Stats{}; }
+
+    // ---- record codec ----
+    static std::string key(node_id_t id) {
+        std::string k(9, 'N');
+        uint64_t v = static_cast<uint64_t>(id);
+        for (int i = 0; i < 8; ++i) k[8 - i] = static_cast<char>((v >> (8 * i)) & 0xff);
+        return k;
+    }
+    struct Rec { std::vector<node_id_t> out; std::string vec; };  // vec = SQ8 bytes or empty
+    static void decode(const std::string& v, Rec* r) {
+        r->out.clear(); r->vec.clear();
+        if (v.size() < 4) return;
+        uint32_t n; std::memcpy(&n, v.data(), 4);
+        r->out.resize(n);
+        if (n) std::memcpy(r->out.data(), v.data() + 4, 8ull * n);
+        size_t off = 4 + 8ull * n;
+        if (v.size() > off) r->vec.assign(v.data() + off, v.size() - off);
+    }
+    static std::string encode(const Rec& r) {
+        uint32_t n = static_cast<uint32_t>(r.out.size());
+        std::string v(4 + 8ull * n, '\0');
+        std::memcpy(&v[0], &n, 4);
+        if (n) std::memcpy(&v[4], r.out.data(), 8ull * n);
+        v += r.vec;
+        return v;
+    }
+
+    // ---- primitive I/O ----
+    bool get(node_id_t id, Rec* r) {
+        std::string v;
+        auto s = db_->Get(ROCKSDB_NAMESPACE::ReadOptions(), key(id), &v);
+        st_.gets++; st_.get_bytes += v.size();
+        if (!s.ok()) { r->out.clear(); r->vec.clear(); return false; }
+        decode(v, r); return true;
+    }
+    void put(node_id_t id, Rec r) {
+        // A vector staged by writeVector() rides along with this record write (so an insert
+        // writes the new node's record once: vector + adjacency, like a coupled Put would).
+        auto pv = pending_vec_.find(id);
+        if (pv != pending_vec_.end()) { r.vec = std::move(pv->second); pending_vec_.erase(pv); }
+        std::string v = encode(r);
+        db_->Put(ROCKSDB_NAMESPACE::WriteOptions(), key(id), v);
+        st_.puts++; st_.put_bytes += v.size(); st_.put_vec_bytes += r.vec.size();
+    }
+
+    // ---- graph API (mirrors Aster EAGER semantics: RMW of the whole value) ----
+    std::vector<node_id_t> getEdges(node_id_t id) {
+        Rec r; uint64_t b0 = st_.get_bytes;
+        get(id, &r);
+        st_.edge_gets++; st_.edge_get_bytes += st_.get_bytes - b0;
+        if (in_query_) expanded_.insert(id);
+        return r.out;
+    }
+    void noteExpanded(node_id_t id) { if (in_query_) expanded_.insert(id); }
+    void setEdges(node_id_t id, std::vector<node_id_t> out) {
+        Rec r; get(id, &r);
+        std::sort(out.begin(), out.end()); out.erase(std::unique(out.begin(), out.end()), out.end());
+        r.out = std::move(out); put(id, r);
+    }
+    void addEdge(node_id_t from, node_id_t to) {
+        Rec r; get(from, &r);
+        auto it = std::lower_bound(r.out.begin(), r.out.end(), to);
+        if (it == r.out.end() || *it != to) r.out.insert(it, to);
+        put(from, r);  // Aster also rewrites when the edge already exists
+    }
+    void deleteEdges(node_id_t from, const std::vector<node_id_t>& tos) {
+        Rec r; get(from, &r);
+        std::unordered_set<node_id_t> del(tos.begin(), tos.end());
+        std::vector<node_id_t> keep; keep.reserve(r.out.size());
+        for (auto x : r.out) if (!del.count(x)) keep.push_back(x);
+        r.out.swap(keep); put(from, r);
+    }
+    void putRecord(node_id_t id, std::vector<node_id_t> out, const std::vector<float>& vec) {
+        Rec r; std::sort(out.begin(), out.end()); out.erase(std::unique(out.begin(), out.end()), out.end());
+        r.out = std::move(out); r.vec.resize(vec_bytes_);
+        PagedVectorStorage::quantize(vec.data(), dim_, &r.vec[0]);
+        put(id, r);
+    }
+
+    // ---- vector API (used by CoupledVectorStorage) ----
+    // onEdges: edges that came back in the same read (the coupled layout's "free" adjacency).
+    std::function<void(node_id_t, const std::vector<node_id_t>&)> onEdges;
+    bool readVector(node_id_t id, float* out) {
+        auto pv = pending_vec_.find(id);
+        if (pv != pending_vec_.end()) {  // staged, not yet written: served from memory
+            PagedVectorStorage::dequantize(pv->second.data(), out, dim_);
+            return true;
+        }
+        Rec r; uint64_t b0 = st_.get_bytes;
+        bool ok = get(id, &r);
+        uint64_t got = st_.get_bytes - b0;
+        st_.vec_gets++; st_.vec_get_bytes += got;
+        if (in_query_) fetched_edge_bytes_[id] = got - r.vec.size();
+        if (!ok || r.vec.size() != vec_bytes_) { std::memset(out, 0, dim_ * sizeof(float)); return false; }
+        PagedVectorStorage::dequantize(r.vec.data(), out, dim_);
+        if (onEdges) onEdges(id, r.out);
+        return true;
+    }
+    // Stages the vector; it is written with the node's next record write (insert: the
+    // linkNeighborsAsterDB setEdges that always follows the vector store at layer 0).
+    void writeVector(node_id_t id, const std::vector<float>& vec) {
+        std::string q(vec_bytes_, '\0');
+        PagedVectorStorage::quantize(vec.data(), dim_, &q[0]);
+        pending_vec_[id] = std::move(q);
+    }
+    size_t pendingVectors() const { return pending_vec_.size(); }
+
+    // ---- per-query unused-bytes accounting ----
+    void beginQuery() { in_query_ = true; fetched_edge_bytes_.clear(); expanded_.clear(); }
+    void endQuery() {
+        for (auto& kv : fetched_edge_bytes_)
+            if (!expanded_.count(kv.first)) st_.unused_edge_bytes += kv.second;
+        st_.queries++; in_query_ = false;
+    }
+
+private:
+    ROCKSDB_NAMESPACE::DB* db_;
+    size_t dim_, vec_bytes_;
+    Stats st_;
+    bool in_query_ = false;
+    std::unordered_map<node_id_t, uint64_t> fetched_edge_bytes_;
+    std::unordered_set<node_id_t> expanded_;
+    std::unordered_map<node_id_t, std::string> pending_vec_;
+};
+
+// IVectorStorage adapter over the coupled records (no separate vector file, no page cache).
+class CoupledVectorStorage : public IVectorStorage {
+public:
+    CoupledVectorStorage(CoupledNodeStore* s, size_t capacity)
+        : s_(s), present_(capacity, 0) {}
+    size_t getVectorDim() const override { return s_->dim(); }
+    size_t getCapacity() const override { return present_.size(); }
+    void storeVectorToDisk(node_id_t id, const std::vector<float>& vec) override {
+        grow(id); s_->writeVector(id, vec); present_[id] = 1;
+    }
+    void readVectorFromDisk(node_id_t id, std::vector<float>& vec) override {
+        vec.resize(s_->dim()); s_->readVector(id, vec.data());
+    }
+    void readVectorsBatchFlat(const std::vector<node_id_t>& ids, float* out, size_t dim) override {
+        for (size_t i = 0; i < ids.size(); ++i) s_->readVector(ids[i], out + i * dim);
+    }
+    void deleteVector(node_id_t id) override { if ((size_t)id < present_.size()) present_[id] = 0; }
+    bool exists(node_id_t id) const override { return (size_t)id < present_.size() && present_[id]; }
+    void markPresent(node_id_t id) { grow(id); present_[id] = 1; }
+    std::size_t bookkeepingBytes() const override { return present_.capacity(); }
+private:
+    void grow(node_id_t id) { if ((size_t)id >= present_.size()) present_.resize(id + 1, 0); }
+    CoupledNodeStore* s_;
+    std::vector<uint8_t> present_;
+};
+
+}  // namespace lsm_vec
