+    r.flush_write   = index_->rocksTicker(rocksdb::FLUSH_WRITE_BYTES);
+    r.compact_write = index_->rocksTicker(rocksdb::COMPACT_WRITE_BYTES);
+    r.compact_read  = index_->rocksTicker(rocksdb::COMPACT_READ_BYTES);
+    r.wal_bytes     = index_->rocksTicker(rocksdb::WAL_FILE_BYTES);
+    r.block_miss    = index_->rocksTicker(rocksdb::BLOCK_CACHE_MISS);
+    r.block_hit     = index_->rocksTicker(rocksdb::BLOCK_CACHE_HIT);
+    r.keys_read     = index_->rocksTicker(rocksdb::NUMBER_KEYS_READ);
+    r.block_bytes_insert = index_->rocksTicker(rocksdb::BLOCK_CACHE_BYTES_WRITE);
