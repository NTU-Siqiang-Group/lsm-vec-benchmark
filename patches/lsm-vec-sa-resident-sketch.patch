+uint32_t SaSketch::addChild(uint32_t parent, const SaSketchNode& child)
+{
+    const uint32_t idx = static_cast<uint32_t>(nodes.size());
+    nodes.push_back(child);
+    nodes[idx].first_child = kSaNoIndex;
+    nodes[idx].next_sibling = kSaNoIndex;
+    nodes[idx].n_children = 0;
+    SaSketchNode& p = nodes[parent];
+    if (p.first_child == kSaNoIndex) {
+        p.first_child = idx;
+    } else {
+        uint32_t c = p.first_child;
+        while (nodes[c].next_sibling != kSaNoIndex) c = nodes[c].next_sibling;
+        nodes[c].next_sibling = idx;
+    }
+    ++nodes[parent].n_children;
+    return idx;
+}
+
+SaSketch SaSketch::fromTree(const SaTree& t)
+{
+    SaSketch s;
+    s.nodes.reserve(t.nodes.size());
+    s.nodes.resize(t.nodes.size());
+    for (size_t i = 0; i < t.nodes.size(); ++i) {
+        const SaTreeNode& n = t.nodes[i];
+        SaSketchNode& o = s.nodes[i];
+        o.id = n.id; o.radius = n.radius; o.parent_dist = n.parent_dist;
+        uint32_t prev = kSaNoIndex;
+        for (uint32_t c : n.children) {
+            if (c >= t.nodes.size()) continue;
+            if (prev == kSaNoIndex) o.first_child = c; else s.nodes[prev].next_sibling = c;
+            prev = c; ++o.n_children;
+        }
+    }
+    s.root_index = t.empty() ? kSaNoIndex : t.root_index;
+    return s;
+}
