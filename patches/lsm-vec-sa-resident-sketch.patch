+Status LSMVecDB::SearchKnnTraced(Span<float> query, const SearchOptions& options,
+                                std::vector<SearchResult>* out,
+                                std::vector<VisitRec>* trace)
+{
+    if (!out || !trace) return Status::InvalidArgument("out/trace must not be null");
+    std::vector<LSMVec::QueryVisit> sink;
+    sink.reserve(4096);
+    index_->setVisitTrace(&sink);
+    Status s = SearchKnn(query, options, out);
+    index_->setVisitTrace(nullptr);  // always detach, even on error
+    trace->clear();
+    trace->reserve(sink.size());
+    for (const auto& v : sink)
+        trace->push_back(VisitRec{v.rank, static_cast<uint32_t>(v.node), v.phase, v.dist_q});
+    return s;
+}
