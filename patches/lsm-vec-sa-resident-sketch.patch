+// Unit tests for the sharded / out-of-core RNN-Descent path
+// (src/lsm_vec_sharded_build.cc). Validates merge invariants, determinism,
+// and graph quality vs the monolithic in-memory builder on the same data.
+
+#include <gtest/gtest.h>
+
+#include <algorithm>
+#include <cmath>
+#include <filesystem>
+#include <random>
+#include <set>
+#include <vector>
+
+#include "lsm_vec_rnn_descent.h"
+#include "lsm_vec_sharded_build.h"
+
+using namespace lsm_vec;
+
+namespace {
+
+// Gaussian mixture so k-means has real structure to find.
+std::vector<float> makeClusteredData(int n, int dim, int n_clusters,
+                                     uint32_t seed) {
+    std::mt19937 rng(seed);
+    std::normal_distribution<float> noise(0.0f, 1.0f);
+    std::uniform_real_distribution<float> center(-50.0f, 50.0f);
+    std::vector<std::vector<float>> centers(n_clusters, std::vector<float>(dim));
+    for (auto& c : centers)
+        for (auto& v : c) v = center(rng);
+    std::vector<float> data(static_cast<size_t>(n) * dim);
+    for (int i = 0; i < n; ++i) {
+        const auto& c = centers[rng() % n_clusters];
+        for (int d = 0; d < dim; ++d)
+            data[static_cast<size_t>(i) * dim + d] = c[d] + noise(rng);
+    }
+    return data;
+}
+
+float l2sq(const float* a, const float* b, int dim) {
+    float s = 0;
+    for (int d = 0; d < dim; ++d) {
+        float t = a[d] - b[d];
+        s += t * t;
+    }
+    return s;
+}
+
+// Fraction of the true k-NN of `probes` sampled nodes present in each node's
+// adjacency list (graph-neighbor recall).
+template <typename OffT>
+double graphKnnRecall(const std::vector<float>& data, int n, int dim,
+                      const std::vector<OffT>& offsets,
+                      const std::vector<int>& neighbors, int k, int probes) {
+    std::mt19937 rng(7);
+    size_t hit = 0, total = 0;
+    for (int p = 0; p < probes; ++p) {
+        int u = static_cast<int>(rng() % n);
+        std::vector<std::pair<float, int>> d;
+        d.reserve(n - 1);
+        for (int v = 0; v < n; ++v) {
+            if (v == u) continue;
+            d.emplace_back(l2sq(&data[static_cast<size_t>(u) * dim],
+                                &data[static_cast<size_t>(v) * dim], dim),
+                           v);
+        }
+        std::partial_sort(d.begin(), d.begin() + k, d.end());
+        std::set<int> have(neighbors.begin() + offsets[u],
+                           neighbors.begin() + offsets[u + 1]);
+        for (int i = 0; i < k; ++i) hit += have.count(d[i].second);
+        total += k;
+    }
+    return static_cast<double>(hit) / static_cast<double>(total);
+}
+
+sharded::ShardedBuildParams testParams(const std::string& tmp) {
+    sharded::ShardedBuildParams p;
+    p.shard_count = 4;
+    p.overlap = 2;
+    p.sample_size = 4000;
+    p.num_threads = 4;
+    p.tmp_dir = tmp;
+    return p;
+}
+
+}  // namespace
+
+TEST(ShardedBuild, MergeInvariantsAndDeterminism) {
+    const int n = 20000, dim = 16;
+    auto data = makeClusteredData(n, dim, 8, 42);
+    auto p = testParams("shard_ut_tmp_a");
+
+    auto csr = sharded::BuildShardedKnnGraph(data.data(), n, dim,
+                                             DistanceMetric::kL2, p);
+
+    ASSERT_EQ(csr.offsets.size(), static_cast<size_t>(n) + 1);
+    EXPECT_EQ(csr.offsets[0], 0);
+    EXPECT_EQ(csr.offsets.back(), static_cast<int64_t>(csr.neighbors.size()));
+    for (int u = 0; u < n; ++u) {
+        int64_t b = csr.offsets[u], e = csr.offsets[u + 1];
+        ASSERT_LE(b, e);
+        ASSERT_LE(e - b, p.rnnd_R);
+        std::set<int> seen;
+        float prev = -1.0f;
+        for (int64_t i = b; i < e; ++i) {
+            int v = csr.neighbors[i];
+            ASSERT_GE(v, 0);
+            ASSERT_LT(v, n);
+            ASSERT_NE(v, u) << "self edge at " << u;
+            ASSERT_TRUE(seen.insert(v).second) << "dup edge " << u << "->" << v;
+            float d = l2sq(&data[static_cast<size_t>(u) * dim],
+                           &data[static_cast<size_t>(v) * dim], dim);
+            ASSERT_GE(d, prev - 1e-3f) << "list not ascending by distance";
+            prev = d;
+        }
+        // Coverage: every node must have at least one neighbor at this scale.
+        ASSERT_GT(e, b) << "isolated node " << u;
+    }
+
+    // Tmp spill files are cleaned up on success.
+    EXPECT_FALSE(std::filesystem::exists("shard_ut_tmp_a/shard_0.bin"));
+
+    // Determinism holds single-threaded (multi-threaded RNND is
+    // interleaving-nondeterministic, same as the monolithic path).
+    const int dn = 6000;
+    auto ddata = makeClusteredData(dn, dim, 6, 77);
+    auto p1 = testParams("shard_ut_tmp_d1");
+    auto p2 = testParams("shard_ut_tmp_d2");
+    p1.num_threads = p2.num_threads = 1;
+    auto d1 = sharded::BuildShardedKnnGraph(ddata.data(), dn, dim,
+                                            DistanceMetric::kL2, p1);
+    auto d2 = sharded::BuildShardedKnnGraph(ddata.data(), dn, dim,
+                                            DistanceMetric::kL2, p2);
+    EXPECT_EQ(d1.offsets, d2.offsets);
+    EXPECT_EQ(d1.neighbors, d2.neighbors);
+}
+
+TEST(ShardedBuild, QualityMatchesMonolithic) {
+    const int n = 20000, dim = 16;
+    auto data = makeClusteredData(n, dim, 8, 43);
+
+    rnn_descent::FlatStorageDistance fdist(data.data(), n, dim,
+                                           DistanceMetric::kL2);
+    rnn_descent::RNNDescentBuilder mono(dim);
+    mono.num_threads = 4;
+    mono.build(fdist, n);
+
+    auto p = testParams("shard_ut_tmp_q");
+    auto csr = sharded::BuildShardedKnnGraph(data.data(), n, dim,
+                                             DistanceMetric::kL2, p);
+
+    const int k = 10, probes = 300;
+    double r_mono = graphKnnRecall(data, n, dim, mono.offsets,
+                                   mono.final_graph, k, probes);
+    double r_shard = graphKnnRecall(data, n, dim, csr.offsets,
+                                    csr.neighbors, k, probes);
+    // The acceptance bar is parity with the monolithic graph — RNND's
+    // absolute graph-kNN recall on this synthetic mixture is itself ~0.55
+    // (approximate builder), so no absolute threshold beyond a sanity floor.
+    EXPECT_GE(r_shard, r_mono - 0.02)
+        << "mono=" << r_mono << " sharded=" << r_shard;
+    EXPECT_GT(r_shard, 0.40);
+    std::printf("graph 10-NN recall: mono=%.3f sharded=%.3f\n", r_mono, r_shard);
+}
+
+TEST(ShardedBuild, SkewSplitStillCovers) {
+    // All mass in ONE tight cluster -> k-means degenerates, the skew guard
+    // must split shards and coverage must survive.
+    const int n = 6000, dim = 8;
+    std::mt19937 rng(11);
+    std::normal_distribution<float> noise(0.0f, 0.01f);
+    std::vector<float> data(static_cast<size_t>(n) * dim);
+    for (auto& v : data) v = noise(rng);
+
+    auto p = testParams("shard_ut_tmp_s");
+    auto csr = sharded::BuildShardedKnnGraph(data.data(), n, dim,
+                                             DistanceMetric::kL2, p);
+    ASSERT_EQ(csr.offsets.size(), static_cast<size_t>(n) + 1);
+    for (int u = 0; u < n; ++u) EXPECT_GT(csr.offsets[u + 1], csr.offsets[u]);
+}
