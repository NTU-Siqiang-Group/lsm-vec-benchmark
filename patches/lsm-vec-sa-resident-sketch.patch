diff --git a/include/lsm_vec_sharded_build.h b/include/lsm_vec_sharded_build.h
new file mode 100644
index 0000000..e583493
--- /dev/null
+++ b/include/lsm_vec_sharded_build.h
@@ -0,0 +1,48 @@
+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <vector>
+
+#include "lsm_vec_rnn_descent.h"  // RNNDescentBuilder, DistanceMetric
+
+namespace lsm_vec::sharded {
+
+// Sharded / out-of-core RNN-Descent (DiskANN-style cluster -> per-shard
+// build -> merge), so bulk builds beyond ~30M points fit in RAM. Only one
+// shard's RNND working set is resident at a time; per-shard neighbor
+// lists spill to tmp_dir and are k-way-merged into a global CSR that is
+// byte-compatible with what the monolithic RNNDescentBuilder emits
+// (per-node lists sorted by ascending distance), except offsets are
+// 64-bit (total edges at 100M x R64 overflow int32).
+struct ShardedBuildParams {
+    int shard_count = 0;          // must be > 1 to call BuildShardedKnnGraph
+    int overlap = 2;              // assign each point to its `overlap` nearest centroids
+    int sample_size = 1'000'000;  // k-means sample (clamped to n)
+    int kmeans_iters = 10;
+    std::string tmp_dir;          // per-shard spill directory (created; files removed on success)
+    // RNND parameters, passed through to the per-shard builders.
+    int rnnd_S = 16;
+    int rnnd_T1 = 4;
+    int rnnd_T2 = 15;
+    int rnnd_R = 64;
+    int num_threads = 1;
+    uint32_t seed = 2021;
+};
+
+struct ShardedCsr {
+    std::vector<int64_t> offsets;  // n+1 entries
+    std::vector<int> neighbors;    // offsets.back() entries, per-node ascending distance
+};
+
+// Build the layer-0 KNN graph over `vectors` (row-major n x dim) without
+// ever holding all n RNND candidate pools in RAM. Sharding/assignment is
+// seed-deterministic; the full output is bit-deterministic only with
+// num_threads=1 (multi-threaded RNND is interleaving-nondeterministic,
+// same as the monolithic path). Throws std::runtime_error on I/O failure
+// or coverage violations.
+ShardedCsr BuildShardedKnnGraph(const float* vectors, size_t n, int dim,
+                                DistanceMetric metric,
+                                const ShardedBuildParams& params);
+
+}  // namespace lsm_vec::sharded
