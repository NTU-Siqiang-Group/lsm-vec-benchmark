+    out.vec_cache_mb   = b.vec_cache;
+    out.update_buf_mb  = b.update_buf;
+    out.edge_cache_mb      = b.edge_cache;
+    out.vec_bookkeeping_mb = b.vec_bookkeeping;
+    out.malloc_live_mb     = b.malloc_live;
+    out.malloc_retained_mb = b.malloc_retained;
+    out.malloc_mmap_mb     = b.malloc_mmap;
+    return out;
