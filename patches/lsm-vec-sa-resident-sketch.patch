diff --git a/test/unit/test_edge_cache.cc b/test/unit/test_edge_cache.cc
new file mode 100644
index 0000000..c8e2694
--- /dev/null
+++ b/test/unit/test_edge_cache.cc
@@ -0,0 +1,72 @@
+// EdgeLRUCache (arena + open addressing + varint) vs a reference list+map model with the old
+// semantics: put() inserts/refreshes at the front, get() does not reorder, eviction takes the back.
+#include <gtest/gtest.h>
+
+#include <list>
+#include <random>
+#include <unordered_map>
+#include <vector>
+
+#include "lsm_vec_index.h"
+
+using lsm_vec::EdgeLRUCache;
+using NodeId = lsm_vec::node_id_t;
+
+namespace {
+
+struct RefCache {
+    size_t cap;
+    std::list<std::pair<NodeId, std::vector<NodeId>>> lru;
+    std::unordered_map<NodeId, decltype(lru)::iterator> map;
+    bool get(NodeId id, std::vector<NodeId>* out) {
+        auto it = map.find(id);
+        if (it == map.end()) return false;
+        *out = it->second->second;
+        return true;
+    }
+    void put(NodeId id, const std::vector<NodeId>& v) {
+        auto it = map.find(id);
+        if (it != map.end()) { it->second->second = v; lru.splice(lru.begin(), lru, it->second); return; }
+        if (map.size() >= cap) { map.erase(lru.back().first); lru.pop_back(); }
+        lru.emplace_front(id, v); map[id] = lru.begin();
+    }
+    void erase(NodeId id) {
+        auto it = map.find(id);
+        if (it == map.end()) return;
+        lru.erase(it->second); map.erase(it);
+    }
+};
+
+void Differential(size_t cap, NodeId id_space, int steps, unsigned seed) {
+    EdgeLRUCache c(cap);
+    RefCache r{cap, {}, {}};
+    std::mt19937_64 rng(seed);
+    std::vector<NodeId> a, b;
+    for (int s = 0; s < steps; ++s) {
+        NodeId id = rng() % id_space;
+        if (rng() % 8 == 0) id |= (NodeId{1} << 63);  // tagged ids: 10-byte varints
+        int op = static_cast<int>(rng() % 10);
+        if (op < 4) {
+            bool ha = c.get(id, &a), hb = r.get(id, &b);
+            ASSERT_EQ(ha, hb) << "step " << s;
+            if (ha) ASSERT_EQ(a, b) << "step " << s;
+        } else if (op < 8) {
+            std::vector<NodeId> v(rng() % 40);
+            for (auto& x : v) x = rng() % (1ull << (rng() % 64));
+            c.put(id, v); r.put(id, v);
+        } else {
+            c.erase(id); r.erase(id);
+        }
+    }
+    for (NodeId id = 0; id < id_space; ++id) {  // final state identical
+        bool ha = c.get(id, &a), hb = r.get(id, &b);
+        ASSERT_EQ(ha, hb);
+        if (ha) ASSERT_EQ(a, b);
+    }
+}
+
+TEST(EdgeCache, DifferentialSmall) { Differential(7, 40, 200000, 1); }
+TEST(EdgeCache, DifferentialHeavyErase) { Differential(64, 300, 200000, 2); }
+TEST(EdgeCache, DifferentialLarge) { Differential(1000, 5000, 200000, 3); }
+
+}  // namespace
