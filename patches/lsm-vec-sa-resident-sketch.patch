+    LSMVec::MemBreakdownMB LSMVec::memBreakdown() const
+    {
+        MemBreakdownMB b;
+        const double MB = 1e6;
+        auto fp = estimateIndexRamFootprint();
+        b.upper_hnsw = (fp.hnsw_nodes_bytes + fp.highest_layer_nodes_bytes) / MB;
+        b.sa_sketch  = (saL0BufferEmbeddingBytes() + fp.sa_clusters_bytes + fp.sa_membership_bytes) / MB;
+        // Paged vector-storage page cache.
+        if (vector_storage_)
+            b.vec_cache = static_cast<double>(vector_storage_->cachedPageCount()) * 4096.0 / MB;
+        // RocksDB: block cache + table readers = graph-edge cache; memtables = write/update buffer.
+        double update_buf = fp.scratch_buffers_bytes + fp.index_deleted_ids_bytes;
+        if (db_ && db_->get_raw_db()) {
+            auto* rdb = db_->get_raw_db();
+            uint64_t memtab = 0, treaders = 0, cache = 0;
+            rdb->GetAggregatedIntProperty("rocksdb.cur-size-all-mem-tables", &memtab);
+            rdb->GetAggregatedIntProperty("rocksdb.estimate-table-readers-mem", &treaders);
+            rdb->GetIntProperty("rocksdb.block-cache-usage", &cache);
+            b.graph_cache = (cache + treaders) / MB;
+            update_buf += memtab;
+        }
+        b.update_buf = update_buf / MB;
+        if (edge_cache_) b.edge_cache = edge_cache_->bytesEstimate() / MB;
+        if (vector_storage_) b.vec_bookkeeping = vector_storage_->bookkeepingBytes() / MB;
+        {
+            struct mallinfo2 mi = mallinfo2();
+            b.malloc_live = static_cast<double>(mi.uordblks) / MB;
+            b.malloc_retained = static_cast<double>(mi.fordblks) / MB;
+            b.malloc_mmap = static_cast<double>(mi.hblkhd) / MB;
+        }
+        return b;
+    }
