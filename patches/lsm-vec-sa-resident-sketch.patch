index 0000000..15aeca2
--- /dev/null
+++ b/test/unit/test_paged_storage.cc
@@ -0,0 +1,97 @@
+// PagedVectorStorage write-buffer consistency (port of AsterVec 4a04417's regression).
+// A first write at slot != 0 into a page whose section buffer is gone (e.g. after flushWrites()
+// at the end of a base build) must not zero the other vectors on that page.
+#include <gtest/gtest.h>
+
+#include <random>
+#include <vector>
+
+#include "test_helpers.h"
+#include "disk_vector.h"
+
+using namespace lsm_vec;
+using namespace lsm_vec::test;
+
+namespace {
+
+constexpr size_t kDim = 16;
+
+std::vector<float> Vec(unsigned seed);
+
+int g_fmt = 0;  // record format under test (0 SQ8, 1 float32, 2 uint8, 3 int8)
+
+// Expected value after the record round trip (SQ8, or exact for float32 records).
+std::vector<float> RoundTrip(const std::vector<float>& v) {
+    if (g_fmt != 0) return v;  // float32 and raw byte formats are exact for integral in-range data
+    std::vector<char> rec(PagedVectorStorage::sq8RecordSize(kDim));
+    PagedVectorStorage::quantize(v.data(), kDim, rec.data());
+    std::vector<float> out(kDim);
+    PagedVectorStorage::dequantize(rec.data(), out.data(), kDim);
+    return out;
+}
+
+int CountMismatches(PagedVectorStorage& s, int n) {
+    int bad = 0;
+    std::vector<float> got;
+    for (int id = 0; id < n; ++id) {
+        s.readVectorFromDisk(id, got);
+        if (got != RoundTrip(Vec(id))) ++bad;
+    }
+    return bad;
+}
+
+void RunScenario(size_t cache_pages, int fmt = 0) {
+    g_fmt = fmt;
+    TempDir dir;
+    PagedVectorStorage s(dir.path() + "/vecs.bin", kDim, 1024, cache_pages, fmt);
+    if (fmt == 1) EXPECT_EQ(s.vectorsPerPage(), 4096u / (kDim * sizeof(float)));
+    if (fmt >= 2) EXPECT_EQ(s.vectorsPerPage(), 4096u / kDim);
+    const size_t vpp = s.vectorsPerPage();
+    ASSERT_GT(vpp, 3u);
+    // Two sections, each with a partially filled page (base build).
+    const int per_section = static_cast<int>(vpp + vpp / 2);
+    int id = 0;
+    for (int sec = 0; sec < 2; ++sec)
+        for (int i = 0; i < per_section; ++i, ++id) s.storeVectorToDisk(id, Vec(id), /*sectionKey=*/1000 + sec);
+    const int base_n = id;
+    s.flushWrites();  // == flushVectorWrites() at the end of the base build
+    ASSERT_EQ(CountMismatches(s, base_n), 0);
+
+    // Streaming inserts land mid-page in each section's open page.
+    for (int sec = 0; sec < 2; ++sec)
+        for (int i = 0; i < 3; ++i, ++id) s.storeVectorToDisk(id, Vec(id), 1000 + sec);
+    EXPECT_EQ(CountMismatches(s, id), 0) << "before flush";
+    s.flushWrites();
+    EXPECT_EQ(CountMismatches(s, id), 0) << "after flush";
+
+    // Fill the rest of the open pages and start new ones; everything must still read back.
+    for (int sec = 0; sec < 2; ++sec)
+        for (size_t i = 0; i < vpp; ++i, ++id) s.storeVectorToDisk(id, Vec(id), 1000 + sec);
+    s.flushWrites();
+    EXPECT_EQ(CountMismatches(s, id), 0) << "after page roll-over";
+}
+
+TEST(PagedStorage, MidPageWriteAfterFlushDoesNotClobber_NoCache) { RunScenario(0); }
+TEST(PagedStorage, MidPageWriteAfterFlushDoesNotClobber_Cache) { RunScenario(64); }
+TEST(PagedStorage, Float32Records_NoCache) { RunScenario(0, 1); }
+TEST(PagedStorage, Float32Records_Cache) { RunScenario(64, 1); }
+TEST(PagedStorage, Uint8Records) { RunScenario(64, 2); }
+TEST(PagedStorage, Int8Records) { RunScenario(64, 3); }
+TEST(PagedStorage, Uint8RejectsNonIntegral) {
+    TempDir dir;
+    PagedVectorStorage s(dir.path() + "/vecs.bin", kDim, 16, 0, 2);
+    std::vector<float> bad(kDim, 1.5f);
+    EXPECT_THROW(s.storeVectorToDisk(0, bad, 0), std::runtime_error);
+}
+
+std::vector<float> Vec(unsigned seed) {
+    // Integral values valid for every format: in [0,127] for uint8 and int8 (SQ8/float32 accept them too).
+    std::mt19937 rng(seed);
+    std::uniform_int_distribution<int> u(1, 127);  // never all-zero
+    std::vector<float> v(kDim);
+    for (auto& x : v) x = static_cast<float>(u(rng));
+    if (g_fmt == 3) for (size_t i = 0; i < kDim; i += 2) v[i] = -v[i];  // exercise negative int8
+    return v;
+}
+
