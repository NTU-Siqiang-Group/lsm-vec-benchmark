diff --git a/graph_test/encoding_test.cc b/graph_test/encoding_test.cc
new file mode 100644
index 000000000..f1cd84159
--- /dev/null
+++ b/graph_test/encoding_test.cc
@@ -0,0 +1,131 @@
+// Standalone test for ENCODING_TYPE_VARINT adjacency encoding:
+// round-trip (including bit-63 flagged ids), encoded-size bounds, and
+// malformed-input rejection. Header-only dependencies; build:
+//   g++ -std=c++17 -I include -I . graph_test/encoding_test.cc -o encoding_test
+#include <cassert>
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+#include "rocksdb/graph.h"
+
+using ROCKSDB_NAMESPACE::Edge;
+using ROCKSDB_NAMESPACE::Edges;
+using ROCKSDB_NAMESPACE::decode_edges;
+using ROCKSDB_NAMESPACE::encode_edges;
+using ROCKSDB_NAMESPACE::free_edges;
+using ROCKSDB_NAMESPACE::node_id_t;
+
+namespace {
+
+constexpr uint64_t kBit63 = 1ULL << 63;
+
+std::string encode(const std::vector<node_id_t>& out_ids,
+                   const std::vector<node_id_t>& in_ids) {
+  Edges e;
+  e.num_edges_out = static_cast<uint32_t>(out_ids.size());
+  e.num_edges_in = static_cast<uint32_t>(in_ids.size());
+  std::vector<Edge> outs(out_ids.size()), ins(in_ids.size());
+  for (size_t i = 0; i < out_ids.size(); i++) outs[i].nxt = out_ids[i];
+  for (size_t i = 0; i < in_ids.size(); i++) ins[i].nxt = in_ids[i];
+  e.nxts_out = outs.data();
+  e.nxts_in = ins.data();
+  std::string value;
+  encode_edges(&e, &value, ENCODING_TYPE_VARINT);  // writes the count header
+  return value;
+}
+
+void test_round_trip() {
+  const std::vector<node_id_t> ids = {
+      0,
+      1,
+      127,
+      128,
+      1000000,
+      (1ULL << 62),
+      static_cast<node_id_t>(kBit63 | 42),
+      static_cast<node_id_t>(kBit63 | 1000000),
+  };
+  std::string value = encode(ids, ids);
+  Edges d;
+  assert(decode_edges(&d, value.data(), value.size(), ENCODING_TYPE_VARINT));
+  assert(d.num_edges_out == ids.size());
+  assert(d.num_edges_in == ids.size());
